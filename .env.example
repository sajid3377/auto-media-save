# Copy to .env and set values
# RapidAPI provider defaults set to AllMedia Downloader listing; change if you pick a different provider
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=allmedia-downloader.p.rapidapi.com
# Optional: If the provider uses a specific path, e.g. /api/v1/universal
RAPIDAPI_PATH=/universal
PORT=3000

# Note: do NOT commit your real RapidAPI key to GitHub. Use environment variables on the server.
